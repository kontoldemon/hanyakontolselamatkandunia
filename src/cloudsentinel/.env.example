# ═══════════════════════════════════════════════════════════════════
# CloudSentinel v2.1 — Environment Configuration Template
# Copy to .env and fill in your values.
# .env is gitignored — never commit real credentials.
# ═══════════════════════════════════════════════════════════════════

# ── LLM (litellm — unified API gateway to 100+ providers) ──────
# Set any ONE of these. litellm auto-detects the provider.
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
TOGETHERAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gemini/gemini-2.0-flash
LLM_FALLBACK_MODELS=groq/llama-3.3-70b-versatile,openai/gpt-4o-mini
LLM_TIMEOUT_SECONDS=8
LLM_MAX_OUTPUT_CHARS=4000
LLM_SESSION_CALL_LIMIT=20
LLM_GLOBAL_HOURLY_LIMIT=200

# ── Redis Streams ──────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# ── NATS ────────────────────────────────────────────────────────
NATS_ENABLED=false
NATS_URL=nats://nats:4222

# ── Kafka / Redpanda ────────────────────────────────────────────
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092

# ── ClickHouse OLAP ─────────────────────────────────────────────
CLICKHOUSE_ENABLED=false
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=default
CLICKHOUSE_TABLE=cloudsentinel_events
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=

# Dashboard totals. 0 means all time. Set 24 for a rolling 24 hour view.
CLOUDSENTINEL_TRUTH_WINDOW_HOURS=0

# ── Elasticsearch SIEM ──────────────────────────────────────────
CLOUDSENTINEL_ES_URL=
CLOUDSENTINEL_ES_API_KEY=
CLOUDSENTINEL_ES_USERNAME=elastic
CLOUDSENTINEL_ES_PASSWORD=

# ── MISP Threat Intel Sharing ───────────────────────────────────
CLOUDSENTINEL_MISP_URL=
CLOUDSENTINEL_MISP_API_KEY=

# ── AbuseIPDB ───────────────────────────────────────────────────
CLOUDSENTINEL_ABUSEIPDB_KEY=

# ── Honeypot Core ───────────────────────────────────────────────
CLOUDSENTINEL_LISTEN_HOST=0.0.0.0
CLOUDSENTINEL_SSH_PORT=2222
CLOUDSENTINEL_HTTP_ENABLED=false
CLOUDSENTINEL_HTTP_PORT=8443
CLOUDSENTINEL_DNS_ENABLED=false
CLOUDSENTINEL_DNS_PORT=53
CLOUDSENTINEL_TLS_ENABLED=false
CLOUDSENTINEL_TLS_CERT_FILE=
CLOUDSENTINEL_TLS_KEY_FILE=
CLOUDSENTINEL_MTLS_ENABLED=false
CLOUDSENTINEL_MTLS_CA_CERT=

# ── Firewall ────────────────────────────────────────────────────
CLOUDSENTINEL_FIREWALL_BACKEND=nftables
CLOUDSENTINEL_FIREWALL_PATH=/usr/sbin/nft

# ── Sandbox (docker | gvisor | firecracker) ─────────────────────
CLOUDSENTINEL_SANDBOX_RUNTIME=gvisor
CLOUDSENTINEL_SANDBOX_MEMORY=128m
CLOUDSENTINEL_SANDBOX_CPUS=0.5
CLOUDSENTINEL_SANDBOX_TIMEOUT=30.0

# ── Observability ───────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# ── SOAR Engine ─────────────────────────────────────────────────
SOAR_FIREWALL_ENABLED=true
SOAR_FIREWALL_DRY_RUN=true
SOAR_RISK_THRESHOLD=70
SOAR_BLOCK_TTL=86400
SOAR_ACTIVE_PROFILE=local
SOAR_MTTB_TARGET_MS=100

# ── Admin API ───────────────────────────────────────────────────
ADMIN_ENABLED=false
ADMIN_PORT=8080
ADMIN_TOKEN=

# ── Authentication ──────────────────────────────────────────────
CLOUDSENTINEL_AUTH_ENABLED=false
CLOUDSENTINEL_AUTH_SECRET=
CLOUDSENTINEL_ADMIN_USER=admin
CLOUDSENTINEL_ADMIN_PASS=

# ── Socket.io Live Stream ───────────────────────────────────────
STREAM_ENABLED=false
STREAM_HOST=0.0.0.0
STREAM_PORT=3001
STREAM_CORS_ORIGIN=*

# ── Webhook Alerts ──────────────────────────────────────────────
CLOUDSENTINEL_SLACK_WEBHOOK=
CLOUDSENTINEL_DISCORD_WEBHOOK=
CLOUDSENTINEL_TELEGRAM_BOT_TOKEN=
CLOUDSENTINEL_TELEGRAM_CHAT_ID=

# ── Secrets Provider (infisical | vault | env) ──────────────────
CLOUDSENTINEL_SECRETS_PROVIDER=env
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
VAULT_ADDR=
VAULT_TOKEN=
